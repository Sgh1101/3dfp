{
  "name": "3dfp",
  "version": "0.3.0",
  "private": true,
  "description": "3D 1인칭 멀티플레이어 브라우저 FPS — 배틀로얄(노리스폰) 골격",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "check": "node scripts/check.js",
    "test": "node test/unit.js && node test/smoke.js",
    "test:ui": "node test/ui-static.js",
    "test:browser": "node test/browser.js",
    "test:soak": "node test/soak.js",
    "test:all": "npm run check && npm run test:ui && npm test && npm run test:soak && npm run test:browser",
    "vendor:three": "node scripts/vendor-three.js"
  },
  "keywords": [
    "fps",
    "three.js",
    "websocket",
    "multiplayer",
    "battle-royale"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "three": "0.170.0"
  }
}
